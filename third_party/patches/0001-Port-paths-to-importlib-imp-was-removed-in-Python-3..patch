From e5341e7104dec3e149564c7550425e0cf144f84d Mon Sep 17 00:00:00 2001
From: "Bernhard M. Wiedemann" <bwiedemann@suse.de>
Date: Sat, 21 Nov 2026 19:48:43 +0100
Subject: [PATCH 1/6] Port paths to importlib (imp was removed in Python 3.12)

get_directory_of_modules used imp.get_suffixes() and imp.load_module().
Use importlib.util.spec_from_file_location/exec_module instead.  The
function is not used by the core at runtime, but it is part of the
public paths module.

Co-Authored-By: Claude Code <noreply@anthropic.com>
---
 gamera-4/gamera/paths.py | 17 ++++++++++-------
 1 file changed, 10 insertions(+), 7 deletions(-)

diff --git a/gamera-4/gamera/paths.py b/gamera-4/gamera/paths.py
index 50a034c..f8a266c 100644
--- a/gamera-4/gamera/paths.py
+++ b/gamera-4/gamera/paths.py
@@ -20,7 +20,7 @@
 #
 
 
-import os, sys, glob, imp  # Python standard library
+import os, sys, glob, importlib.util  # Python standard library
 from gamera.backport import dircache
 if 1:
    def dummy():
@@ -55,14 +55,17 @@ def get_directory_of_modules(dir, base=''):
    modules = glob.glob(os.path.join(dir, "*.py"))
    names = [os.path.basename(x).split('.')[0] for x in modules]
    mods = []
-   suffixes = imp.get_suffixes()
-   for i in suffixes:
-      if i[0] == '.py':
-         suffix = i
-         break
    for m, name in zip(modules, names):
       try:
-         module = imp.load_module(base + name, file(m, 'r'), m, suffix)
+         spec = importlib.util.spec_from_file_location(base + name, m)
+         module = importlib.util.module_from_spec(spec)
+         # imp.load_module registered the module; keep that behaviour
+         sys.modules[spec.name] = module
+         try:
+            spec.loader.exec_module(module)
+         except BaseException:
+            del sys.modules[spec.name]
+            raise
          mods.append(module)
       except Exception as e:
          print(e)

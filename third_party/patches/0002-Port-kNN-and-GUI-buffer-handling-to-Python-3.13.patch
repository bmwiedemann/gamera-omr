@@ -209,12 +210,17 @@ PyObject* to_string(T& m) {
 }
 
 static char *get_writable_buffer(PyObject *py_buffer, size_t nrows, size_t ncols) {
-	if (PyObject_CheckReadBuffer(py_buffer) == 1) {
+	if (GAMERA_PyObject_CheckReadBuffer(py_buffer) == 1) {
 		// Old Buffer Protocol
-		char *buffer;
-		Py_ssize_t buffer_len;
-		PyObject_AsWriteBuffer(py_buffer, (void **)&buffer, &buffer_len);
-		
+		char *buffer = nullptr;
+		Py_ssize_t buffer_len = 0;
+		if (GAMERA_PyObject_AsWriteBuffer(py_buffer, (void **)&buffer, &buffer_len) < 0) {
+			// e.g. a read-only bytes object; buffer would be uninitialized
+			PyErr_Clear();
+			printf("The buffer passed to to_buffer is not writable.\n");
+			return nullptr;
+		}
+
 		if ((size_t)buffer_len != nrows * ncols * 3 || buffer == nullptr) {
 			printf("The image passed to to_buffer is not of the correct size.\n");
 			return nullptr;
diff --git a/gamera-4/include/pycompat.hpp b/gamera-4/include/pycompat.hpp
new file mode 100644
index 0000000..b39ca93
--- /dev/null
+++ b/gamera-4/include/pycompat.hpp
@@ -0,0 +1,56 @@
+#ifndef GAMERA_PYCOMPAT_HPP
+#define GAMERA_PYCOMPAT_HPP
+
+#include <Python.h>
+
+/*
+ * Python 3.13 removed the old (pre-PEP 3118) buffer API:
+ *   PyObject_CheckReadBuffer, PyObject_AsReadBuffer, PyObject_AsWriteBuffer.
+ *
+ * Gamera's kNN and GUI code still uses it.  These are copies of CPython's own
+ * Python 3.0-3.12 implementations (Objects/abstract.c), so behaviour is the
+ * same on every Python version and one code path is used everywhere.
+ *
+ * As with the originals, the buffer is released before returning: the
+ * pointer stays valid only while the exporter is alive and is not resized.
+ */
+
+static inline int
+GAMERA_PyObject_CheckReadBuffer(PyObject *obj)
+{
+    Py_buffer view;
+    if (!PyObject_CheckBuffer(obj))
+        return 0;
+    if (PyObject_GetBuffer(obj, &view, PyBUF_SIMPLE) < 0) {
+        PyErr_Clear();
+        return 0;
+    }
+    PyBuffer_Release(&view);
+    return 1;
+}
+
+static inline int
+GAMERA_PyObject_AsReadBuffer(PyObject *obj, const void **buf, Py_ssize_t *len)
+{
+    Py_buffer view;
+    if (PyObject_GetBuffer(obj, &view, PyBUF_SIMPLE) < 0)
+        return -1;
+    *buf = view.buf;
+    *len = view.len;
+    PyBuffer_Release(&view);
+    return 0;
+}
+
+static inline int
+GAMERA_PyObject_AsWriteBuffer(PyObject *obj, void **buf, Py_ssize_t *len)
+{
+    Py_buffer view;
+    if (PyObject_GetBuffer(obj, &view, PyBUF_WRITABLE) < 0)
+        return -1;
+    *buf = view.buf;
+    *len = view.len;
+    PyBuffer_Release(&view);
+    return 0;
+}
+
+#endif /* GAMERA_PYCOMPAT_HPP */

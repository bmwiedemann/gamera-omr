+++ b/musicstaves/gamera/toolkits/musicstaves/stafffinder_miyao.py
@@ -188,7 +188,7 @@ with
             stdout.write(msg)
             stdout.flush()
         def getcplistimage(cplist):
-            size = max([self.staffline_height*2, self.staffspace_height/3])
+            size = max([self.staffline_height*2, self.staffspace_height//3])
             rgb = self.image.to_rgb()
             col1 = None
